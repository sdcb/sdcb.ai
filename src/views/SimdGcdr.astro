---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeWindow from '../components/CodeWindow.astro';
import BarCompare from '../components/BarCompare.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { href, t, fmtNumber, fmtDate, type Lang } from '../i18n';
import { snapshot, repo, release, nugetDownloads } from '../data/snapshot';
import { qqGroups, wechatGroups } from '../data/community';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (zh: string, en: string) => t(lang, { zh, en });

const r = repo('SimdGcdrNet');
const rel = release('SimdGcdrNet');
const packages = snapshot.nuget.packages.filter((p) => p.id.toLowerCase().startsWith('sdcb.simdgcdrnet'));
const pkgRows = packages.length
  ? packages
  : [
      { id: 'Sdcb.SimdGcdrNet', version: '1.0.0', downloads: 0 },
      { id: 'Sdcb.SimdGcdrNet.Models', version: '1.0.0', downloads: 0 },
    ];
const totalDownloads = nugetDownloads(['Sdcb.SimdGcdrNet']);
const ocrWechat = wechatGroups.find((g) => g.key === 'ocr')!;
const ocrQQ = qqGroups.find((g) => g.id === ocrWechat.fallbackQQ)!;

const install = `dotnet add package Sdcb.SimdGcdrNet
dotnet add package Sdcb.SimdGcdrNet.Models`;

const samples = [
  {
    id: 'core',
    label: 'Core',
    code: `using Sdcb.SimdGcdrNet;
using Sdcb.SimdGcdrNet.Models;

// Auto：macOS Apple Silicon 优先 Metal，否则 Vulkan，最后退回 CPU（默认值是 Cpu）
using GcdrEnhancer enh = GcdrEnhancer.FromBytes(GcdrModels.GcNet, GcdrModels.DrNet, GcdrBackend.Auto);
// 不用模型包时：GcdrEnhancer.FromFiles("gcdrnet_gcnet_sim.onnx", "gcdrnet_drnet_sim.onnx", ...)

byte[] dst = enh.Enhance(bgr, width: 1600, height: 1152);   // 紧密排列的 BGR24，HWC
// 带 stride、任意 8 位交错格式，输出与输入同格式（alpha 原样拷回），可原地写：
enh.Enhance(srcSpan, w, h, srcStride, dstSpan, dstStride, GcdrPixelFormat.Rgba32);`,
  },
  {
    id: 'imagesharp',
    label: 'ImageSharp',
    code: `using SixLabors.ImageSharp;
using SixLabors.ImageSharp.Formats;
using SixLabors.ImageSharp.PixelFormats;
using System.Runtime.InteropServices;

// 克隆 Default：改 Configuration.Default 会丢掉解码器注册
Configuration cfg = Configuration.Default.Clone();
cfg.PreferContiguousImageBuffers = true;
using Image<Rgba32> image = Image.Load<Rgba32>(new DecoderOptions { Configuration = cfg }, "sample.jpg");
if (!image.DangerousTryGetSinglePixelMemory(out Memory<Rgba32> memory))
    throw new InvalidOperationException("pixel buffer is not contiguous");
Span<byte> pixels = MemoryMarshal.AsBytes(memory.Span);

// 原地增强：src 与 dst 是同一块内存
enh.Enhance(pixels, image.Width, image.Height, image.Width * 4, pixels, image.Width * 4, GcdrPixelFormat.Rgba32);`,
  },
  {
    id: 'skiasharp',
    label: 'SkiaSharp',
    code: `using SkiaSharp;

using SKBitmap bitmap = SKBitmap.Decode("sample.jpg").Copy(SKColorType.Bgra8888);
unsafe
{
    enh.Enhance(
        new ReadOnlySpan<byte>((byte*)bitmap.GetPixels(), bitmap.RowBytes * bitmap.Height),
        bitmap.Width, bitmap.Height, bitmap.RowBytes,
        new Span<byte>((byte*)bitmap.GetPixels(), bitmap.RowBytes * bitmap.Height),
        bitmap.RowBytes, GcdrPixelFormat.Bgra32);
}`,
  },
  {
    id: 'opencv',
    label: 'OpenCvSharp',
    code: `using OpenCvSharp;

using Mat image = Cv2.ImRead("sample.jpg", ImreadModes.Color);
int stride = (int)image.Step();   // Mat 的 Step() 直接当 stride 传
unsafe
{
    enh.Enhance(
        new ReadOnlySpan<byte>((byte*)image.Data, stride * image.Height),
        image.Width, image.Height, stride,
        new Span<byte>((byte*)image.Data, stride * image.Height),
        stride, GcdrPixelFormat.Bgr24);
}`,
  },
  {
    id: 'bitmap',
    label: 'System.Drawing',
    code: `using System.Drawing;
using System.Drawing.Imaging;

using Bitmap bitmap = new("sample.jpg");
BitmapData data = bitmap.LockBits(new(0, 0, bitmap.Width, bitmap.Height),
    ImageLockMode.ReadWrite, PixelFormat.Format24bppRgb);
try
{
    unsafe
    {
        Span<byte> pixels = new((byte*)data.Scan0, data.Stride * bitmap.Height);
        enh.Enhance(pixels, data.Width, data.Height, data.Stride, pixels, data.Stride, GcdrPixelFormat.Bgr24);
    }
}
finally { bitmap.UnlockBits(data); }`,
  },
  {
    id: 'gpu',
    label: 'GPU · Vulkan/Metal',
    code: `using GcdrEnhancer enh = GcdrEnhancer.FromBytes(GcdrModels.GcNet, GcdrModels.DrNet, GcdrBackend.Auto);

// Auto：macOS Apple Silicon 上 Metal，有 Vulkan 计算设备则 Vulkan，否则 CPU；
// 也可显式写 GcdrBackend.Vulkan / Metal / Cpu。
// Vulkan：单命令缓冲图执行，融合流水线 bgr2nchw → GC → div6 → DR → nchw2bgr。`,
  },
];

const backends = [
  { name: 'AVX-512', note: 'x64', icon: 'cpu' },
  { name: 'AVX2 · FMA · MT', note: 'x64', icon: 'cpu' },
  { name: 'AdvSIMD (NEON)', note: 'ARM64', icon: 'cpu' },
  { name: 'PackedSimd', note: 'WASM SIMD128', icon: 'cpu' },
  { name: 'Vector<T> / scalar', note: 'portable', icon: 'cpu' },
  { name: 'Vulkan', note: 'cross-platform', icon: 'zap', gpu: true },
  { name: 'Metal', note: 'Apple Silicon', icon: 'zap', gpu: true },
];

const matrix: { os: string; archs: string[]; gpu: string }[] = [
  { os: 'Windows', archs: ['x64', 'ARM64'], gpu: 'Vulkan' },
  { os: 'Linux', archs: ['x64', 'ARM64'], gpu: 'Vulkan' },
  { os: 'macOS', archs: ['x64', 'ARM64'], gpu: 'Metal' },
  { os: 'Android', archs: ['ARM64'], gpu: 'Vulkan' },
  { os: 'Browser', archs: ['wasm'], gpu: '–' },
];
---

<Base
  lang={lang}
  title="SimdGcdrNet"
  description={L(
    'SimdGcdrNet：纯 C# 的 GCDRNet（IEEE TAI 2023）文档去阴影与外观增强库，不依赖 onnxruntime 等第三方推理引擎，自带图编译器与 SIMD/Vulkan/Metal 后端。',
    'SimdGcdrNet: pure-C# GCDRNet (IEEE TAI 2023) document-image shadow removal and appearance enhancement — no onnxruntime or any third-party inference engine, with its own graph compiler and SIMD / Vulkan / Metal backends.',
  )}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <div class="pointer-events-none absolute -top-48 right-0 h-[500px] w-[700px] rounded-full bg-accent/10 blur-[120px]"></div>
    <div class="container-x relative grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.08fr_1fr]">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip border-accent/40 text-accent">{L('新发布', 'New')}</span>
          {
            rel ? (
              <a href={rel.url} target="_blank" rel="noopener" class="chip hover:text-fg">latest {rel.tag} · {fmtDate(rel.publishedAt, lang)}</a>
            ) : (
              <span class="chip">v1.0.0</span>
            )
          }
          <span class="chip">Apache-2.0 · MIT models</span>
          <span class="chip">net10.0</span>
        </div>
        <h1 class="mt-6 font-mono text-5xl font-bold tracking-tight sm:text-7xl">
          Simd<span class="gradient-text">GcdrNet</span>
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-pretty text-fg-soft sm:text-2xl">
          {
            L(
              '纯 C# 的 GCDRNet（IEEE TAI 2023）：手机拍摄文档的去阴影与外观增强。不依赖 onnxruntime 或任何第三方推理引擎。',
              'Pure-C# GCDRNet (IEEE TAI 2023): shadow removal and appearance enhancement for camera-captured documents. No onnxruntime or any third-party inference engine.',
            )
          }
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={href(lang, '/simdgcdrnet/playground')} class="btn-brand"><Icon name="sparkles" /> {L('在浏览器里试试', 'Try it in your browser')}</a>
          <a href="https://github.com/sdcb/SimdGcdrNet" target="_blank" rel="noopener" class="btn-ghost">
            <Icon name="github" /> GitHub
            <span class="border-l border-line-strong pl-2 font-mono text-xs text-fg-soft" data-repo-stars="SimdGcdrNet">{fmtNumber(r?.stars ?? 0, 'en')}</span>
          </a>
          <a href="https://www.nuget.org/packages/Sdcb.SimdGcdrNet" target="_blank" rel="noopener" class="btn-ghost">NuGet</a>
        </div>
        <div class="mt-10 max-w-xl">
          <CodeWindow code={install} lang="powershell" title={L('安装', 'Install')} uiLang={lang} />
        </div>
      </div>
      <div data-reveal>
        <BeforeAfter
          lang={lang}
          before="/gcdr/samples/poster.jpg"
          after="/gcdr/samples/poster-enhanced.jpg"
          width={1280}
          height={960}
          alt={L('手机拍摄的手抄报：左半边带手影，右半边为 SimdGcdrNet 增强后的效果', 'A hand-drawn poster shot on a phone: hand shadow on the left, SimdGcdrNet output on the right')}
        />
        <p class="mt-3 text-center font-mono text-[11px] text-fg-mute">
          {L('拖动分割线对比：手机拍摄的手抄报，硬手影', 'Drag the divider — a phone photo of a poster with a hard hand shadow')}
        </p>
      </div>
    </div>
  </section>

  <!-- KEY FACTS -->
  <section class="container-x mt-16">
    <div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4 [&>*]:bg-surface">
    {
      [
        [L('0 个', '0'), L('第三方推理引擎依赖', 'third-party inference deps')],
        ['~9.6 ms', L('RTX 3080 Ti Vulkan 端到端（1600×1152）', 'Vulkan end-to-end on a 3080 Ti (1600×1152)')],
        ['5.9×', L('对比 PyTorch 端到端 57.2 ms（纯推理 30.5 ms）', 'vs PyTorch e2e 57.2 ms (30.5 ms pure)')],
        ['~700 ms', L('浏览器中每张图（WASM SIMD + Web Workers）', 'per image in the browser (WASM SIMD + Workers)')],
      ].map(([v, l]) => (
        <div class="px-6 py-6">
          <div class="font-mono text-3xl font-semibold tracking-tight">{v}</div>
          <div class="mt-1 text-sm text-fg-mute">{l}</div>
        </div>
      ))
    }
    </div>
  </section>

  <!-- WHY + PIPELINE -->
  <section class="container-x pt-24">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{L('为什么', 'Why')}</p>
        <h2 class="h-section mt-3">{L('手机拍文档，先去掉影子再谈识别', 'Shadows out of phone photos, before anything else')}</h2>
        <div class="mt-6 space-y-4 leading-relaxed text-fg-soft">
          <p>
            {
              L(
                '手机拍的文档照片几乎必有手影、折痕和背面透字。GCDRNet 用两级网络处理：GC-Net 先估计逐像素的光照/阴影图，做一次除法校正，再把原图和校正图一起喂给 DR-Net 还原细节。',
                'Phone photos of documents almost always carry hand shadows, creases and show-through. GCDRNet is a two-stage network: GC-Net estimates a per-pixel illumination map, a division correction follows, then DR-Net consumes both the original and the corrected image to restore detail.',
              )
            }
          </p>
          <p>
            {
              L(
                'SimdGcdrNet 把这个模型连同推理引擎一起搬进了 C#：自带 ONNX proto 读取和图编译器（shape 特化、常量折叠、算子融合、arena 规划），卷积、LayerNorm、激活全部手写 SIMD。没有 onnxruntime，没有任何第三方推理引擎——一个 NuGet 包就是全部。',
                'SimdGcdrNet ports the model and the inference engine itself into C#: a bundled ONNX proto reader and a graph compiler (shape specialization, constant folding, operator fusion, arena planning), with convolutions, LayerNorm and activations hand-written in SIMD. No onnxruntime, no third-party inference engine — one NuGet package is everything.',
              )
            }
          </p>
          <ul class="grid gap-2 pt-1 text-sm sm:grid-cols-2">
            {
              [
                L('任意 8 位交错格式 Bgr24 / Rgb24 / Bgra32 / Rgba32', 'Any interleaved 8-bit layout: Bgr24 / Rgb24 / Bgra32 / Rgba32'),
                L('任意 stride，可以原地增强', 'Arbitrary strides, in-place enhancement'),
                L('GcdrEnhancer 线程安全', 'Thread-safe GcdrEnhancer'),
                L('Native AOT 兼容', 'Native AOT compatible'),
                L('模型以嵌入资源零拷贝加载', 'Models embedded as resources, zero-copy'),
                L('补齐 32 倍数 replicate padding，自动裁回', 'Pads to a multiple of 32 (replicate), crops back'),
              ].map((s) => (
                <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 shrink-0 text-ok" /><span class="text-fg-soft">{s}</span></li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- pipeline -->
      <div class="card p-6 font-mono text-xs" data-reveal>
        <div class="text-fg-mute">{L('两级流水线', 'Two-stage pipeline')}</div>
        <div class="mt-3 grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-2 text-center">
          <span class="rounded-md border border-line bg-surface-2 px-2 py-2">I_s</span>
          <span class="h-px bg-line-strong"></span>
          <span class="rounded-md border border-brand/40 bg-brand-soft px-2 py-2 text-brand">GC-Net</span>
          <span class="h-px bg-line-strong"></span>
          <span class="rounded-md border border-line bg-surface-2 px-2 py-2">I_sm</span>
        </div>
        <div class="mt-2 grid grid-cols-3 gap-2 text-center text-[10px] text-fg-mute">
          <span>{L('原图', 'input')}</span><span>{L('光照估计', 'illumination')}</span><span>{L('阴影图', 'shading map')}</span>
        </div>
        <div class="mx-auto h-4 w-px bg-line-strong"></div>
        <div class="rounded-lg border border-line bg-surface-2 px-3 py-3 text-center">
          I_GC = clamp(I_s / I_sm, 0, 1)
          <span class="text-fg-mute"> — {L('除法校正', 'division correction')}</span>
        </div>
        <div class="mx-auto h-4 w-px bg-line-strong"></div>
        <div class="rounded-lg border border-brand/40 bg-brand-soft px-3 py-3 text-center text-brand">
          DR-Net
          <span class="text-fg-mute"> [I_s; I_GC] 6ch → {L('增强图', 'enhanced')}</span>
        </div>

        <div class="mt-6 text-fg-mute">{L('推理引擎', 'Engine')}</div>
        <div class="mt-3 rounded-lg border border-line bg-surface-2 px-3 py-3 text-center">
          {L('托管 ONNX proto 读取', 'Managed ONNX proto reader')}
          <span class="text-fg-mute"> · zero inference deps</span>
        </div>
        <div class="mx-auto h-4 w-px bg-line-strong"></div>
        <div class="rounded-lg border border-line bg-surface-2 px-3 py-3 text-center">
          {L('图编译器', 'Graph compiler')}
          <span class="text-fg-mute"> — {L('shape 特化 · 常量折叠 · 算子融合 · arena 规划', 'shape specialization · constant folding · operator fusion · arena planning')}</span>
        </div>
        <div class="mx-auto h-4 w-px bg-line-strong"></div>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            backends.map((b) => (
              <div class:list={['rounded-lg border px-2.5 py-2.5', b.gpu ? 'border-accent/40 bg-accent/10' : 'border-line bg-surface']}>
                <div class:list={['font-semibold', b.gpu ? 'text-accent' : 'text-fg']}>{b.name}</div>
                <div class="mt-0.5 text-[10px] text-fg-mute">{b.note}</div>
              </div>
            ))
          }
        </div>
        <p class="mt-4 text-[11px] text-fg-mute">
          {L('青色为 GPU 后端。浏览器里固定走 CPU 的 PackedSimd 档。', 'Teal: GPU backends. In the browser it is always the CPU PackedSimd tier.')}
        </p>
      </div>
    </div>
  </section>

  <!-- CODE -->
  <section class="container-x pt-24">
    <p class="eyebrow">{L('上手', 'Quick start')}</p>
    <h2 class="h-section mt-3">{L('选你喜欢的图像库，像素内存直接传', 'Bring your own imaging library — pass pixel memory directly')}</h2>
    <div class="mt-8" data-tabs>
      <div class="flex flex-wrap gap-1.5" role="tablist">
        {
          samples.map((s, i) => (
            <button
              type="button"
              role="tab"
              data-tab={s.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              class="rounded-md border border-line px-3 py-1.5 font-mono text-xs text-fg-soft aria-selected:border-brand/50 aria-selected:bg-brand-soft aria-selected:text-brand"
            >
              {s.label}
            </button>
          ))
        }
      </div>
      {
        samples.map((s, i) => (
          <div data-panel={s.id} hidden={i !== 0} class="mt-4">
            <CodeWindow code={s.code} title="Program.cs" uiLang={lang} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- PERF -->
  <section class="container-x pt-24">
    <p class="eyebrow">{L('性能', 'Performance')}</p>
    <h2 class="h-section mt-3">{L('从 RTX 到骁龙，再到浏览器', 'From RTX to Snapdragon to the browser')}</h2>
    <p class="lead mt-4 max-w-3xl">
      {
        L(
          '数据来自仓库 docs/ 下各机型报告（49 张 RealDAE 语料，去掉预热后的均值）。',
          'Numbers from the per-device reports under docs/ (49-image RealDAE corpus, warm-up excluded).',
        )
      }
      <a class="link" href="https://github.com/sdcb/SimdGcdrNet/blob/main/docs/perf.md" target="_blank" rel="noopener">perf.md</a> ·
      <a class="link" href="https://github.com/sdcb/SimdGcdrNet/blob/main/docs/wasm.md" target="_blank" rel="noopener">wasm.md</a> ·
      <a class="link" href="https://github.com/sdcb/SimdGcdrNet/blob/main/docs/corpus.md" target="_blank" rel="noopener">corpus.md</a>
    </p>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <div class="card p-6" data-reveal>
        <h3 class="text-sm font-medium">{L('RTX 3080 Ti · 1600×1152 单张', 'RTX 3080 Ti · single 1600×1152')}</h3>
        <p class="mt-1 mb-5 text-xs text-fg-mute">PyTorch vs SimdGcdrNet Vulkan</p>
        <BarCompare
          unit=" ms"
          beforeLabel="PyTorch"
          afterLabel="Vulkan"
          rows={[
            { label: L('纯推理', 'inference only'), before: 30.5, after: 9.6 },
            { label: L('端到端（含前后处理）', 'end-to-end (with pre/post)'), before: 57.2, after: 9.6 },
          ]}
        />
        <p class="mt-6 text-xs leading-relaxed text-fg-mute">
          {L('SimdGcdrNet 的 9.6 ms 本身已包含上传/下载与前后处理。', "SimdGcdrNet's 9.6 ms already includes upload/download and pre/post.")}
        </p>
      </div>
      <div class="card p-6" data-reveal style="--delay:80ms">
        <h3 class="text-sm font-medium">{L('语料均值 · CPU vs GPU', 'Corpus mean · CPU vs GPU')}</h3>
        <p class="mt-1 mb-5 text-xs text-fg-mute">49 RealDAE · ms/img</p>
        <BarCompare
          unit=" ms"
          beforeLabel="CPU"
          afterLabel="Vulkan"
          rows={[
            { label: 'RTX 3080 Ti', before: 722, after: 28 },
            { label: 'Arc B580', before: 414, after: 36 },
            { label: 'Radeon 880M', before: 285, after: 100 },
            { label: 'Adreno 750 (8 Gen 3)', before: 1030, after: 486 },
          ]}
        />
      </div>
      <div class="card p-6" data-reveal style="--delay:160ms">
        <h3 class="text-sm font-medium">{L('浏览器 browser-wasm', 'In the browser')}</h3>
        <p class="mt-1 mb-5 text-xs text-fg-mute">Edge · Ryzen 9 5950X · ms/img</p>
        <BarCompare
          unit=" ms"
          beforeLabel="Vector<float>"
          afterLabel="PackedSimd"
          rows={[
            { label: L('语料均值（49 张）', 'corpus mean (49 img)'), before: 1081, after: 696 },
            { label: L('1152×1600 推理（gc+dr）', '1152×1600 gc+dr'), before: 636.3, after: 393.7 },
          ]}
        />
        <p class="mt-6 text-xs leading-relaxed text-fg-mute">
          {L('同一台 5950X 的桌面 AVX2 约 420 ms/张——浏览器里达到了它的六成性能。', 'Desktop AVX2 on the same 5950X runs ~420 ms/img — the browser reaches 60% of it.')}
        </p>
      </div>
    </div>
  </section>

  <!-- PAIRS WITH OCR -->
  <section class="container-x pt-24">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{L('组合拳', 'Pairs well')}</p>
        <h2 class="h-section mt-3">{L('增强完，再接 SimdPaddleOCR', 'Enhance, then hand off to SimdPaddleOCR')}</h2>
        <p class="mt-5 leading-relaxed text-fg-soft">
          {
            L(
              '两个库都吃同一块解码后的像素内存：SimdGcdrNet 原地增强，SimdPaddleOCR 直接识别，中间不需要任何编码/拷贝。右图这页 RealDAE 样张背面透字严重——原图 OCR 出 56 行（大多是背面透过来的乱码），增强后只剩正文的 14 行。',
              'Both libraries consume the same decoded pixel buffer: SimdGcdrNet enhances in place and SimdPaddleOCR reads it straight — no re-encoding, no copies. This RealDAE page on the right has heavy show-through: OCR on the original returns 56 lines (mostly garbage from the back side), on the enhanced image the 14 real lines.',
            )
          }
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-xs">
          <span class="chip">{L('原图 OCR：56 行', 'original OCR: 56 lines')}</span>
          <Icon name="arrowRight" size={13} class="text-fg-mute" />
          <span class="chip border-ok/40 text-ok">{L('增强后：14 行正文', 'enhanced: the 14 real lines')}</span>
        </div>
        <div class="mt-7">
          <a href={href(lang, '/simdpaddleocr')} class="btn-primary">SimdPaddleOCR <Icon name="arrowRight" /></a>
        </div>
      </div>
      <div data-reveal>
        <BeforeAfter
          lang={lang}
          before="/gcdr/samples/document.jpg"
          after="/gcdr/samples/document-enhanced.jpg"
          width={1056}
          height={1586}
          alt={L('RealDAE 文档样张：背面透字在增强后基本消失', 'A RealDAE document page: show-through mostly gone after enhancement')}
        />
        <p class="mt-3 text-center font-mono text-[11px] text-fg-mute">
          {L('背面透字（show-through）在增强后基本消失', 'Back-side show-through is nearly gone after enhancement')}
        </p>
      </div>
    </div>
  </section>

  <!-- PLATFORMS -->
  <section class="container-x pt-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="eyebrow">{L('平台', 'Platforms')}</p>
        <h2 class="h-section mt-3">{L('一个包，到处都能跑', 'One package, everywhere')}</h2>
        <ul class="mt-6 space-y-3 text-sm text-fg-soft">
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 shrink-0 text-ok" />{L('目标框架：net10.0', 'Targets net10.0')}</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 shrink-0 text-ok" />{L('NativeAOT 兼容（IsAotCompatible，无裁剪/AOT 警告）', 'NativeAOT compatible (IsAotCompatible, no trim/AOT warnings)')}</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 shrink-0 text-ok" />{L('模型（约 21 MB）从程序集嵌入资源直接加载', 'Models (~21 MB) load straight from embedded resources')}</li>
          <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 shrink-0 text-ok" />{L('骁龙 8 Gen 3 / RK3399 / 浏览器实测', 'Measured on Snapdragon 8 Gen 3, RK3399 and in the browser')}</li>
        </ul>
      </div>
      <div class="overflow-hidden rounded-xl border border-line">
        <table class="w-full text-left font-mono text-xs">
          <thead class="bg-surface-2 text-fg-mute">
            <tr>
              <th class="px-4 py-3 font-medium">OS</th>
              <th class="px-4 py-3 font-medium">CPU</th>
              <th class="px-4 py-3 font-medium">GPU</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line bg-surface">
            {
              matrix.map((m) => (
                <tr>
                  <td class="px-4 py-3.5 font-semibold text-fg">{m.os}</td>
                  <td class="px-4 py-3.5">
                    <div class="flex flex-wrap gap-1.5">
                      {m.archs.map((a) => (
                        <span class="chip">{a}</span>
                      ))}
                    </div>
                  </td>
                  <td class="px-4 py-3.5">
                    {m.gpu === '–' ? <span class="text-fg-mute">–</span> : <span class="chip border-accent/40 text-accent">{m.gpu}</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section class="container-x pt-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">NuGet</p>
        <h2 class="h-section mt-3">{L('包与模型', 'Packages & models')}</h2>
      </div>
      {totalDownloads > 0 && (
        <p class="font-mono text-sm text-fg-mute">{L('累计下载', 'Total downloads')} <b class="text-fg">{fmtNumber(totalDownloads, lang)}</b></p>
      )}
    </div>
    <div class="mt-8 divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface">
      {
        pkgRows.map((p) => (
          <a
            href={`https://www.nuget.org/packages/${p.id}`}
            target="_blank"
            rel="noopener"
            class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 hover:bg-surface-2"
          >
            <span class="font-mono text-sm">{p.id}</span>
            <span class="flex gap-5 font-mono text-xs text-fg-mute">
              <span>v{p.version}</span>
              <span class="inline-flex items-center gap-1">
                <Icon name="download" size={12} />
                {p.downloads > 0 ? fmtNumber(p.downloads, lang) : '–'}
              </span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="mt-4 text-xs leading-relaxed text-fg-mute">
      {
        L(
          'Models 包约 21 MB（GC-Net + DR-Net 两个 ONNX），以嵌入资源提供，版本独立于引擎。',
          'The Models package is ~21 MB (GC-Net + DR-Net ONNX), shipped as embedded resources and versioned independently of the engine.',
        )
      }
    </p>
  </section>

  <!-- CREDITS -->
  <section class="container-x pt-24">
    <div class="card p-8 sm:p-10">
      <p class="eyebrow">{L('致谢', 'Credits')}</p>
      <div class="mt-4 max-w-3xl space-y-3 leading-relaxed text-fg-soft">
        <p>
          {
            L(
              '模型来自论文《Appearance Enhancement for Camera-captured Document Images in the Wild》（IEEE TAI 2023）与上游实现 ',
              'The model comes from the paper “Appearance Enhancement for Camera-captured Document Images in the Wild” (IEEE TAI 2023) and its upstream implementation ',
            )
          }
          <a class="link" href="https://github.com/ZZZHANG-jx/GCDRNet" target="_blank" rel="noopener">ZZZHANG-jx/GCDRNet</a>
          {L('（权重 MIT，Copyright (c) 2024 Jiaxin Zhang）。', ' (weights under MIT, Copyright (c) 2024 Jiaxin Zhang).')}
        </p>
        <p>
          {
            L(
              '示例图与测试语料取自同一论文的 RealDAE 数据集（sdcb/DocGainFixture）。推理引擎 Sdcb.SimdGcdrNet 为 Apache-2.0。',
              'Sample images and the test corpus come from the RealDAE dataset of the same paper (sdcb/DocGainFixture). The Sdcb.SimdGcdrNet engine is Apache-2.0.',
            )
          }
        </p>
      </div>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class="container-x pt-24">
    <div class="card flex flex-col items-start gap-8 p-8 sm:flex-row sm:items-center sm:p-10">
      <img
        src={ocrWechat.qr}
        alt={L('计算机视觉微信群二维码', 'WeChat group QR code')}
        width="1207"
        height="1688"
        loading="lazy"
        referrerpolicy="no-referrer"
        class="h-auto w-40 shrink-0 rounded-lg border border-line bg-white"
        onerror="this.style.display='none'"
      />
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">{L('C#/.NET 计算机视觉技术交流', 'C#/.NET Computer Vision community')}</h2>
        <p class="mt-2 text-fg-soft">
          {
            L(
              '扫码加入微信群；二维码每周更新，如已过期，请先加 QQ 群 579060605。',
              'Scan to join the WeChat group. The QR code rotates weekly — if it has expired, join QQ group 579060605 instead.',
            )
          }
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={ocrQQ.link} target="_blank" rel="noopener" class="btn-primary"><Icon name="users" /> QQ {ocrQQ.id}</a>
          <a href={href(lang, '/community')} class="btn-ghost">{L('全部社区入口', 'All community channels')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
