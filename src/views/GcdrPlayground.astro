---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { href, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = (zh: string, en: string) => t(lang, { zh, en });
// runtime.js / dotnet.js are not fingerprinted; a per-build query keeps stale edge/browser copies from pairing with new hashed assets.
const gcdrVersion = Date.now().toString(36);

const i18n = {
  downloading: L('正在下载 .NET 运行时与模型', 'Downloading .NET runtime and models'),
  warming: L('正在初始化推理引擎', 'Initializing the inference engine'),
  ready: L('就绪', 'Ready'),
  running: L('增强中', 'Enhancing'),
  failed: L('加载失败', 'Failed to load'),
};
---

<Base
  lang={lang}
  title={L('SimdGcdrNet 在线体验', 'SimdGcdrNet Playground')}
  description={L(
    '在浏览器里直接运行纯 C# 的 SimdGcdrNet：.NET WebAssembly 多线程 + SIMD 本地去除文档照片阴影，图片不会上传到任何服务器。',
    'Run pure-C# SimdGcdrNet right in your browser via multithreaded .NET WebAssembly. Your image never leaves your device.',
  )}
>
  <section class="container-x pt-16 sm:pt-20">
    <a href={href(lang, '/simdgcdrnet')} class="inline-flex items-center gap-1 font-mono text-xs text-fg-mute hover:text-fg">← SimdGcdrNet</a>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
      Playground <span class="gradient-text">·</span> <span class="text-fg-mute">browser-wasm</span>
    </h1>
    <p class="lead mt-4 max-w-3xl">
      {
        L(
          '同一套 C# 代码，编译成 WebAssembly 跑在你的浏览器里——多线程 Web Workers + 128 位 SIMD。图片不会离开你的电脑：没有服务器，没有 ONNX Runtime。',
          'The very same C# code, compiled to WebAssembly and running in your browser — multithreaded Web Workers and 128-bit SIMD. Your image never leaves your machine: no server, no ONNX Runtime.',
        )
      }
    </p>
  </section>

  <section class="container-x pt-10">
    <div
      id="gp"
      class="grid gap-5 lg:grid-cols-[1.35fr_1fr]"
      data-i18n={JSON.stringify(i18n)}
      data-gcdr-version={gcdrVersion}
    >
      <!-- left: image -->
      <div class="card overflow-hidden">
        <div class="flex flex-wrap items-center gap-2 border-b border-line px-4 py-3">
          <label class="btn-ghost cursor-pointer px-3 py-1.5 text-xs">
            <Icon name="image" size={14} /> {L('选择图片', 'Choose image')}
            <input id="gp-file" type="file" accept="image/*" class="sr-only" />
          </label>
          <span class="flex items-center gap-1.5">
            <button type="button" class="overflow-hidden rounded-md border border-line transition hover:border-brand" data-sample="/gcdr/samples/poster.jpg" title={L('示例：手影海报', 'Sample: hand-shadow poster')}>
              <img src="/gcdr/samples/poster.jpg" alt="" width="1280" height="960" class="h-8 w-12 object-cover" />
            </button>
            <button type="button" class="overflow-hidden rounded-md border border-line transition hover:border-brand" data-sample="/gcdr/samples/document.jpg" title={L('示例：背面透字文档', 'Sample: show-through document')}>
              <img src="/gcdr/samples/document.jpg" alt="" width="1056" height="1586" class="h-8 w-12 object-cover" />
            </button>
          </span>
          <span class="ml-auto flex items-center gap-2">
            <span class="hidden items-center gap-0.5 rounded-lg border border-line bg-surface-2 p-0.5 sm:flex" id="gp-view">
              <button type="button" data-view="compare" class="rounded-md px-2.5 py-1 text-xs text-fg aria-selected:bg-brand-soft aria-selected:text-brand" aria-selected="true">{L('对比', 'Compare')}</button>
              <button type="button" data-view="src" class="rounded-md px-2.5 py-1 text-xs text-fg-soft aria-selected:bg-brand-soft aria-selected:text-brand" aria-selected="false">{L('原图', 'Original')}</button>
              <button type="button" data-view="dst" class="rounded-md px-2.5 py-1 text-xs text-fg-soft aria-selected:bg-brand-soft aria-selected:text-brand" aria-selected="false">{L('增强', 'Enhanced')}</button>
            </span>
            <button id="gp-save" type="button" class="btn-ghost px-3 py-1.5 text-xs" disabled>
              <Icon name="download" size={14} /> PNG
            </button>
          </span>
        </div>
        <div id="gp-drop" class="relative grid min-h-[420px] place-items-center bg-bg-soft p-4 transition-colors data-[over]:bg-brand-soft">
          <div id="gp-stage" class="relative hidden max-w-full select-none" style="--pos:50%; touch-action: pan-y">
            <canvas id="gp-src" class="block max-h-[70vh] max-w-full rounded-md"></canvas>
            <canvas id="gp-dst" class="absolute inset-0 h-full w-full rounded-md" style="clip-path: inset(0 0 0 var(--pos))"></canvas>
            <div id="gp-divider" class="pointer-events-none absolute inset-y-0 left-[var(--pos)] w-px -translate-x-1/2 bg-white/80 shadow-[0_0_10px_rgba(0,0,0,0.55)]"></div>
            <div
              id="gp-handle"
              role="slider"
              tabindex="0"
              aria-label={L('拖动对比原图与增强效果', 'Drag to compare original and enhanced')}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="50"
              class="absolute top-1/2 left-[var(--pos)] z-10 flex size-9 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize items-center justify-center rounded-full border border-white/60 bg-black/50 text-white shadow-lg backdrop-blur transition-colors hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path>
              </svg>
            </div>
            <div id="gp-scan" class="pointer-events-none absolute inset-0 hidden overflow-hidden rounded-md">
              <div class="scan-beam"></div>
            </div>
          </div>
          <div id="gp-empty" class="text-center text-sm text-fg-mute">
            <Icon name="image" size={36} class="mx-auto mb-3 opacity-50" />
            {L('拖一张带阴影的文档照片到这里', 'Drop a shadowed document photo here')}
            <div class="mt-1 text-xs">{L('也可以 Ctrl+V 粘贴', 'or Ctrl+V to paste')}</div>
          </div>
          <div id="gp-blocked" class="hidden max-w-md rounded-lg border border-warn/40 bg-warn/10 px-5 py-4 text-center text-sm text-fg-soft">
            {L(
              '当前页面缺少跨域隔离（crossOriginIsolated = false），多线程 WASM 需要 COOP / COEP 响应头。请确认部署的 _headers 已生效。',
              'This page is not cross-origin isolated (crossOriginIsolated = false). Multithreaded WASM needs the COOP / COEP response headers — check that the deployed _headers file is in effect.',
            )}
          </div>
        </div>
      </div>

      <!-- right: status + note -->
      <div class="grid content-start gap-5">
        <div class="card p-5 font-mono text-xs">
          <div class="flex items-center justify-between">
            <span class="text-fg-mute">runtime</span>
            <span id="gp-state" class="inline-flex items-center gap-2 text-fg-soft">
              <span class="size-2 rounded-full bg-warn" data-dot></span><span data-label>{i18n.downloading}</span>
            </span>
          </div>
          <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-surface-2">
            <div id="gp-progress" class="h-full w-0 rounded-full bg-brand transition-[width] duration-300"></div>
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5">
            <dt class="text-fg-mute">{L('资源', 'assets')}</dt><dd id="gp-dl" class="text-right">–</dd>
            <dt class="text-fg-mute">{L('启动 .NET', 'boot .NET')}</dt><dd id="gp-boot" class="text-right">–</dd>
            <dt class="text-fg-mute">{L('模型加载', 'model load')}</dt><dd id="gp-load" class="text-right">–</dd>
            <dt class="text-fg-mute">{L('线程', 'threads')}</dt><dd id="gp-threads" class="text-right">–</dd>
            <dt class="text-fg-mute">SIMD</dt><dd id="gp-simd" class="text-right">–</dd>
            <dt class="text-fg-mute">{L('分辨率', 'resolution')}</dt><dd id="gp-res" class="text-right">–</dd>
            <dt class="text-fg-mute">{L('增强耗时', 'enhance')}</dt><dd id="gp-ms" class="text-right text-base font-semibold text-brand">–</dd>
          </dl>
          <p id="gp-runtime" class="mt-4 truncate text-[10px] text-fg-mute"></p>
        </div>

        <p class="text-xs leading-relaxed text-fg-mute">
          {
            L(
              '浏览器里是 128 位 WASM SIMD + Web Workers 多线程：每个新尺寸的首次运行会先编译执行计划（会慢一些），之后就快了。桌面端的 AVX2 / AVX-512 / Vulkan / Metal 还要快得多——真实速度请用 NuGet 包跑。',
              'In the browser this is 128-bit WASM SIMD plus Web Workers. The first run at a new size compiles an execution plan, so it runs slower; later runs reuse it. Desktop AVX2 / AVX-512 / Vulkan / Metal are much faster — run the NuGet package for real numbers.',
            )
          }
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .scan-beam {
    position: absolute;
    inset-inline: 0;
    height: 22%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--c-brand) 28%, transparent) 45%,
      color-mix(in srgb, var(--c-brand) 70%, transparent) 50%,
      color-mix(in srgb, var(--c-brand) 28%, transparent) 55%,
      transparent
    );
    filter: blur(1px);
    animation: gcdr-scan 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate;
  }
  @keyframes gcdr-scan {
    from { transform: translateY(-110%); }
    to { transform: translateY(560%); }
  }
  #gp-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.375rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
    background: color-mix(in srgb, var(--c-bg) 18%, transparent);
  }
  #gp-stage[data-busy]::after {
    opacity: 1;
  }
</style>

<script>
  type RtInfo = { loadMs: number; runtime: string; simd: boolean; vectorBits: number; threads: number; bootMs: number };
  type Rt = {
    start: (o?: { onProgress?: (loaded: number, total: number) => void }) => Promise<RtInfo>;
    enhance: (rgba: Uint8Array, w: number, h: number) => Promise<{ rgba: Uint8ClampedArray<ArrayBuffer>; ms: number }>;
  };

  const root = document.getElementById('gp')!;
  const i18n = JSON.parse(root.dataset.i18n!) as Record<string, string>;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const state = $('gp-state');
  const stage = $('gp-stage');
  const srcCanvas = $<HTMLCanvasElement>('gp-src');
  const dstCanvas = $<HTMLCanvasElement>('gp-dst');
  const srcCtx = srcCanvas.getContext('2d', { willReadFrequently: true })!;
  const dstCtx = dstCanvas.getContext('2d', { willReadFrequently: true })!;
  const divider = $('gp-divider');
  const handle = $('gp-handle');
  const scan = $('gp-scan');
  const saveBtn = $<HTMLButtonElement>('gp-save');
  const MAX_SIDE = 1600;

  let api: Rt | null = null;
  let ready = false;
  let running = false;
  let pending: ImageData | null = null;
  let bitmap: ImageBitmap | null = null;
  let pos = 50;
  let view: 'compare' | 'src' | 'dst' = 'compare';
  let enhanced = false;

  const fmtMs = (ms: number) => (ms >= 1000 ? `${(ms / 1000).toFixed(2)} s` : `${ms.toFixed(0)} ms`);

  function setState(label: string, color: string) {
    state.querySelector<HTMLElement>('[data-label]')!.textContent = label;
    state.querySelector<HTMLElement>('[data-dot]')!.className = `size-2 rounded-full ${color}`;
  }

  function setPos(p: number) {
    pos = Math.min(97, Math.max(3, p));
    stage.style.setProperty('--pos', `${pos}%`);
    handle.setAttribute('aria-valuenow', String(Math.round(pos)));
  }

  function applyView() {
    const onlyDst = view === 'dst' && enhanced;
    dstCanvas.style.clipPath = onlyDst ? 'none' : 'inset(0 0 0 var(--pos))';
    dstCanvas.style.display = view === 'src' || !enhanced ? 'none' : '';
    divider.style.display = view === 'compare' && enhanced ? '' : 'none';
    handle.style.display = view === 'compare' && enhanced ? '' : 'none';
  }

  // divider drag / keyboard
  const fromPointer = (e: PointerEvent) => ((e.clientX - stage.getBoundingClientRect().left) / stage.clientWidth) * 100;
  let dragging = false;
  stage.addEventListener('pointerdown', (e) => {
    if (view !== 'compare') return;
    dragging = true;
    stage.setPointerCapture(e.pointerId);
    setPos(fromPointer(e));
  });
  stage.addEventListener('pointermove', (e) => {
    if (dragging) setPos(fromPointer(e));
  });
  stage.addEventListener('pointerup', () => (dragging = false));
  stage.addEventListener('pointercancel', () => (dragging = false));
  handle.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 2;
    if (e.key === 'ArrowLeft') setPos(pos - step);
    else if (e.key === 'ArrowRight') setPos(pos + step);
    else if (e.key === 'Home') setPos(3);
    else if (e.key === 'End') setPos(97);
    else return;
    e.preventDefault();
  });

  async function load(blob: Blob) {
    bitmap?.close();
    bitmap = await createImageBitmap(blob);
    const scale = Math.min(1, MAX_SIDE / Math.max(bitmap.width, bitmap.height));
    srcCanvas.width = Math.round(bitmap.width * scale);
    srcCanvas.height = Math.round(bitmap.height * scale);
    dstCanvas.width = srcCanvas.width;
    dstCanvas.height = srcCanvas.height;
    srcCtx.drawImage(bitmap, 0, 0, srcCanvas.width, srcCanvas.height);
    stage.classList.remove('hidden');
    $('gp-empty').classList.add('hidden');
    $('gp-res').textContent = `${srcCanvas.width}×${srcCanvas.height}`;
    enhanced = false;
    saveBtn.disabled = true;
    applyView();
    const data = srcCtx.getImageData(0, 0, srcCanvas.width, srcCanvas.height);
    if (ready && !running) run(data);
    else pending = data;
  }

  async function run(data: ImageData) {
    if (!api) return;
    running = true;
    pending = null;
    stage.dataset.busy = '';
    scan.classList.remove('hidden');
    try {
      const { rgba, ms } = await api.enhance(new Uint8Array(data.data.buffer.slice(0)), data.width, data.height);
      // a newer image arrived mid-run: drop this stale frame, `finally` runs the pending one
      if (pending) return;
      dstCtx.putImageData(new ImageData(rgba, data.width, data.height), 0, 0);
      $('gp-ms').textContent = fmtMs(ms);
      enhanced = true;
      saveBtn.disabled = false;
      applyView();
    } catch (err) {
      setState(`${i18n.failed}: ${String((err as Error)?.message ?? err)}`, 'bg-red-500');
      console.error(err);
    } finally {
      running = false;
      delete stage.dataset.busy;
      scan.classList.add('hidden');
      if (pending) run(pending);
    }
  }

  async function boot() {
    try {
      const rt = (await import(/* @vite-ignore */ `/gcdr/runtime.js?v=${root.dataset.gcdrVersion}`)) as Rt;
      api = rt;
      const info = await rt.start({
        onProgress: (loaded, total) => {
          $('gp-progress').style.width = `${Math.min(100, (loaded / Math.max(1, total)) * 100)}%`;
          $('gp-dl').textContent = `${loaded}/${total}`;
        },
      });
      ready = true;
      setState(i18n.ready, 'bg-ok');
      $('gp-progress').style.width = '100%';
      $('gp-dl').textContent = '✓';
      $('gp-boot').textContent = fmtMs(info.bootMs);
      $('gp-load').textContent = fmtMs(info.loadMs);
      $('gp-threads').textContent = String(info.threads);
      $('gp-simd').textContent = info.simd ? `✓ ${info.vectorBits}-bit` : '✗';
      $('gp-runtime').textContent = info.runtime;
      if (pending) run(pending);
    } catch (e) {
      setState(`${i18n.failed}: ${String((e as Error)?.message ?? e)}`, 'bg-red-500');
      console.error(e);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('#gp-view [data-view]').forEach((b) =>
    b.addEventListener('click', () => {
      view = b.dataset.view as typeof view;
      document.querySelectorAll<HTMLButtonElement>('#gp-view [data-view]').forEach((x) =>
        x.setAttribute('aria-selected', String(x === b)),
      );
      applyView();
    }),
  );

  saveBtn.addEventListener('click', () => {
    dstCanvas.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'enhanced.png';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    }, 'image/png');
  });

  $<HTMLInputElement>('gp-file').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) load(f);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
    b.addEventListener('click', async () => load(await (await fetch(b.dataset.sample!)).blob())),
  );
  const drop = $('gp-drop');
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.dataset.over = '';
  });
  drop.addEventListener('dragleave', () => delete drop.dataset.over);
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    delete drop.dataset.over;
    const f = e.dataTransfer?.files?.[0];
    if (f?.type.startsWith('image/')) load(f);
  });
  window.addEventListener('paste', (e) => {
    const f = [...(e.clipboardData?.files ?? [])].find((x) => x.type.startsWith('image/'));
    if (f) load(f);
  });

  if (!crossOriginIsolated) {
    setState(i18n.failed, 'bg-red-500');
    $('gp-empty').classList.add('hidden');
    $('gp-blocked').classList.remove('hidden');
  } else {
    boot();
    fetch('/gcdr/samples/poster.jpg')
      .then((r) => r.blob())
      .then(load);
  }
</script>
