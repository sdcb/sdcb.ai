---
import Base from '../layouts/Base.astro';
---

<Base lang="zh" title="404">
  <section class="container-x grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="font-mono text-sm text-fg-mute">System.IO.FileNotFoundException</p>
      <h1 class="mt-4 font-mono text-7xl font-bold tracking-tight"><span class="gradient-text">404</span></h1>
      <p class="mt-5 text-fg-soft">这个页面不存在 · This page doesn't exist.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">回到首页</a>
        <a href="/en/" class="btn-ghost">Home (English)</a>
      </div>
    </div>
  </section>
</Base>
