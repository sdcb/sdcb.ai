---
import Icon from './Icon.astro';
import { href, nav, switchPath, t, fmtNumber, type Lang } from '../i18n';
import { totals } from '../data/snapshot';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = path.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (p: string) => current === p || current.startsWith(p + '/');
const other: Lang = lang === 'zh' ? 'en' : 'zh';
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/75 backdrop-blur-xl">
  <div class="container-x flex h-16 items-center gap-6">
    <a href={href(lang, '/')} class="group flex items-center gap-1 font-mono text-[17px] font-semibold tracking-tight" aria-label="sdcb.ai">
      <span class="text-brand">&gt;</span>
      <span>sdcb</span><span class="text-fg-mute">.ai</span>
      <span class="ml-0.5 inline-block h-[1.05em] w-[0.55em] translate-y-[1px] bg-brand animate-blink"></span>
    </a>

    <nav class="hidden flex-1 items-center gap-1 lg:flex" aria-label={t(lang, { zh: '主导航', en: 'Main' })}>
      {
        nav.map((n) => (
          <a
            href={href(lang, n.path)}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              isActive(n.path) ? 'bg-surface-2 text-fg' : 'text-fg-soft hover:text-fg',
            ]}
            aria-current={isActive(n.path) ? 'page' : undefined}
          >
            {t(lang, n.label)}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={switchPath(Astro.url.pathname, other)}
        class="rounded-md px-2.5 py-1.5 font-mono text-xs text-fg-soft hover:bg-surface-2 hover:text-fg"
        hreflang={other === 'zh' ? 'zh-CN' : 'en'}
        data-lang-switch={other}
        title={other === 'zh' ? '切换到中文' : 'Switch to English'}
      >
        {other === 'zh' ? '中文' : 'EN'}
      </a>
      <button
        type="button"
        class="rounded-md p-2 text-fg-soft hover:bg-surface-2 hover:text-fg"
        data-theme-toggle
        aria-label={t(lang, { zh: '切换深浅色', en: 'Toggle theme' })}
      >
        <Icon name="sun" class="hidden dark:block" />
        <Icon name="moon" class="block dark:hidden" />
      </button>
      <a
        href="https://github.com/sdcb"
        target="_blank"
        rel="noopener"
        class="ml-1 hidden items-center gap-2 rounded-lg border border-line-strong px-3 py-1.5 text-xs font-medium hover:bg-surface-2 sm:inline-flex"
      >
        <Icon name="github" size={15} />
        <span>sdcb</span>
        <span class="flex items-center gap-1 border-l border-line-strong pl-2 font-mono text-fg-soft">
          <Icon name="star" size={12} />
          <span data-stat="stars" data-format="short">{fmtNumber(totals.stars, 'en')}</span>
        </span>
      </a>
      <button
        type="button"
        class="rounded-md p-2 text-fg-soft hover:bg-surface-2 lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(lang, { zh: '打开菜单', en: 'Open menu' })}
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line bg-bg lg:hidden" data-menu>
    <div class="container-x grid gap-1 py-3">
      {
        nav.map((n) => (
          <a
            href={href(lang, n.path)}
            class:list={['rounded-md px-3 py-2.5 text-[15px]', isActive(n.path) ? 'bg-surface-2 text-fg' : 'text-fg-soft']}
          >
            {t(lang, n.label)}
          </a>
        ))
      }
    </div>
  </nav>
</header>
