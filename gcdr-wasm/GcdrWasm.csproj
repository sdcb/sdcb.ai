<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- Web Workers + SharedArrayBuffer: the page must be crossOriginIsolated (COOP/COEP) -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- needs the wasm-tools workload; the Mono interpreter is ~10x slower on the SIMD kernels -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <!-- Cloudflare compresses on the fly; skip the .br/.gz duplicates -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sdcb.SimdGcdrNet" Version="1.0.0" />
    <PackageReference Include="Sdcb.SimdGcdrNet.Models" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Sdcb.SimdGcdrNet" />
    <TrimmerRootAssembly Include="Sdcb.SimdGcdrNet.Models" />
  </ItemGroup>

</Project>
